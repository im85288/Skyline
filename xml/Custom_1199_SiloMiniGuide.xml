<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/build_tv.py: edit that, not this. Right in Live TV: the mini TV guide. -->
<window id="1199" type="dialog">
    <defaultcontrol always="true">5650</defaultcontrol>
    <!-- The list reloads as it opens (timer silo_mini_first puts it on the playing channel). -->
    <onload>ClearProperty(silo.mini.placed,home)</onload>
    <onload>SetProperty(silokodi.recent_changed,$INFO[System.Time(hh:mm:ss)],home)</onload>
    <controls>
        <control type="group">
            <animation effect="slide" start="1140,0" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="1140,0" time="200" tween="cubic" easing="in">WindowClose</animation>
            <control type="image">
                <left>780</left><top>0</top><width>220</width><height>1080</height>
                <texture flipx="true" colordiffuse="F20C1224">silo/scrim_side.png</texture>
            </control>
            <control type="image">
                <left>1000</left><top>0</top><width>920</width><height>1080</height>
                <texture colordiffuse="F20C1224">colors/white.png</texture>
            </control>
            <control type="wraplist" id="5650">
                <left>1000</left><top>27</top><width>920</width><height>1053</height>
                <orientation>vertical</orientation>
                <focusposition>4</focusposition>
                <scrolltime tween="cubic" easing="out">220</scrolltime>
                <onleft>Dialog.Close(1199)</onleft><onright>noop</onright>
                <content target="videos">plugin://plugin.video.kodiconnectforsilo/?mode=mini_guide&amp;v=$INFO[Window(Home).Property(silokodi.recent_changed)]</content>
                <onclick>Dialog.Close(1199)</onclick>
                <onclick>SetProperty(silo.live.hide,1,home)</onclick>
                <onclick>RunPlugin(plugin://plugin.video.kodiconnectforsilo/?mode=play_channel&amp;id=$INFO[ListItem.Property(silo.channelid)])</onclick>
                <animation effect="fade" start="100" end="0" time="0" condition="String.IsEmpty(Window(Home).Property(silo.mini.placed))">Conditional</animation>
                <itemlayout height="92" width="920">
                <control type="image">
                    <left>40</left><top>24</top><width>150</width><height>44</height>
                    <aspectratio align="left">keep</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>230</left><top>0</top><width>600</width><height>92</height>
                    <aligny>center</aligny>
                    <font>silo_meta</font>
                    <textcolor>C8EDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.now)]</label>
                </control>
                </itemlayout>
                <focusedlayout height="290" width="920">
                <control type="image">
                    <left>20</left><top>14</top><width>850</width><height>262</height>
                    <texture border="20" colordiffuse="1EFFFFFF">silo/card_landscape_mask.png</texture>
                </control>
                <control type="image">
                    <left>20</left><top>14</top><width>850</width><height>262</height>
                    <texture border="20" colordiffuse="50FFFFFF">silo/card_landscape_rim.png</texture>
                </control>
                <control type="image">
                    <left>50</left><top>48</top><width>160</width><height>56</height>
                    <aspectratio align="left">keep</aspectratio>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>230</left><top>36</top><width>580</width><height>50</height>
                    <font>silo_row</font>
                    <textcolor>FFEDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.now)]</label>
                    <visible>!String.IsEqual(ListItem.Property(silo.live),1)</visible>
                </control>
                <control type="label">
                    <left>306</left><top>36</top><width>504</width><height>50</height>
                    <font>silo_row</font>
                    <textcolor>FFEDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.now)]</label>
                    <visible>String.IsEqual(ListItem.Property(silo.live),1)</visible>
                </control>
                <control type="group">
                    <left>230</left><top>48</top>
                    <control type="image">
                        <width>60</width><height>28</height>
                        <texture border="8" colordiffuse="FFE0262F">silo/badge_solid.png</texture>
                        <visible>String.IsEqual(ListItem.Property(silo.live),1)</visible>
                    </control>
                    <control type="label">
                        <width>60</width><height>28</height>
                        <align>center</align><aligny>center</aligny>
                        <font>silo_badge</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>LIVE</label>
                        <visible>String.IsEqual(ListItem.Property(silo.live),1)</visible>
                    </control>
                </control>
                <control type="label">
                    <left>230</left><top>92</top><width>580</width><height>34</height>
                    <font>silo_detail</font>
                    <textcolor>CCEDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.channel)]</label>
                </control>
                <control type="label">
                    <left>230</left><top>128</top><width>580</width><height>34</height>
                    <font>silo_detail</font>
                    <textcolor>CCEDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.started),Started at ]</label>
                </control>
                <control type="image">
                    <left>440</left><top>130</top><width>66</width><height>30</height>
                    <texture border="8" colordiffuse="FFEDEDED">silo/badge_outline.png</texture>
                    <visible>String.IsEqual(ListItem.Property(silo.playing),1) + !String.IsEmpty(VideoPlayer.VideoResolution)</visible>
                </control>
                <control type="label">
                    <left>440</left><top>130</top><width>66</width><height>30</height>
                    <align>center</align><aligny>center</aligny>
                    <font>silo_badge</font>
                    <textcolor>FFEDEDED</textcolor>
                    <label>$VAR[SiloLiveQuality]</label>
                    <visible>String.IsEqual(ListItem.Property(silo.playing),1) + !String.IsEmpty(VideoPlayer.VideoResolution)</visible>
                </control>
                <control type="image">
                    <left>516</left><top>130</top><width>66</width><height>30</height>
                    <texture border="8" colordiffuse="FFEDEDED">silo/badge_outline.png</texture>
                    <visible>String.IsEqual(ListItem.Property(silo.playing),1) + !String.IsEmpty(VideoPlayer.AudioChannels)</visible>
                </control>
                <control type="label">
                    <left>516</left><top>130</top><width>66</width><height>30</height>
                    <align>center</align><aligny>center</aligny>
                    <font>silo_badge</font>
                    <textcolor>FFEDEDED</textcolor>
                    <label>$VAR[SiloLiveAudio]</label>
                    <visible>String.IsEqual(ListItem.Property(silo.playing),1) + !String.IsEmpty(VideoPlayer.AudioChannels)</visible>
                </control>
                <control type="progress">
                    <left>230</left><top>180</top><width>580</width><height>6</height>
                    <texturebg colordiffuse="40FFFFFF">colors/white.png</texturebg>
                    <midtexture colordiffuse="FFEDEDED">colors/white.png</midtexture>
                    <info>ListItem.Property(silo.progress)</info>
                </control>
                <control type="label">
                    <left>230</left><top>204</top><width>580</width><height>34</height>
                    <font>silo_detail</font>
                    <textcolor>FFEDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.next),[COLOR BEEDEDED]Next:[/COLOR]  ]</label>
                </control>
                <control type="label">
                    <left>230</left><top>204</top><width>580</width><height>34</height>
                    <align>right</align>
                    <font>silo_detail</font>
                    <textcolor>BEEDEDED</textcolor>
                    <label>$INFO[ListItem.Property(silo.next_time)]</label>
                </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
