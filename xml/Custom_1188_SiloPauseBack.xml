    <onload condition="!Skin.TimerIsRunning(silo_pause_shown)">Dialog.Close(1188,true)</onload>
    <onload condition="!Skin.TimerIsRunning(silo_pause_shown) + !Skin.TimerIsRunning(silo_mini_closed) + VideoPlayer.Content(LiveTV)">SetProperty(silo.guide.fromplayer,1,home)</onload>
